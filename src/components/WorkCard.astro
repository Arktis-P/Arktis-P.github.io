---
import type { CollectionEntry } from "astro:content";
import MediaBlock from "./MediaBlock.astro";
import { getWorkMedia } from "../lib/media";
import { t } from "../lib/i18n";
interface Props { work: CollectionEntry<"works">; }
const { work } = Astro.props;
const { data } = work;
const media = getWorkMedia(data.slug);
const base = "work." + data.slug;
const categoryKey = "common.category." + data.category;
---
<article class="card" data-category={data.category}>
  <a class="card-media" href={"/works/" + data.slug + "/"}>
    <MediaBlock src={media.cover} altKey={base + ".cover.alt"} hintKey="common.image.pending" />
  </a>
  <div class="card-body">
    <div class="card-meta">
      <div class="card-meta-tags">
        <span class="meta-pill" data-i18n-key={categoryKey}>{t(categoryKey)}</span>
        {data.status === "in-development" && (
          <span class="meta-pill meta-pill-status" data-i18n-key="common.status.in-development">{t("common.status.in-development")}</span>
        )}
      </div>
      <span class="card-platform" data-i18n-key={base + ".platforms"}>{t(base + ".platforms")}</span>
    </div>
    <h2><a href={"/works/" + data.slug + "/"} data-i18n-key={base + ".title"}>{t(base + ".title")}</a></h2>
    <p data-i18n-key={base + ".summary"}>{t(base + ".summary")}</p>
    <a class="card-link" href={"/works/" + data.slug + "/"}><span data-i18n-key="works.card.view">{t("works.card.view")}</span> <span class="arrow" aria-hidden="true">→</span></a>
  </div>
</article>
