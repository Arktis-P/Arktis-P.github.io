---
import type { CollectionEntry } from "astro:content";
import MediaBlock from "./MediaBlock.astro";
import { getWorkMedia } from "../lib/media";

interface Props { work: CollectionEntry<"works">; }
const { work } = Astro.props;
const { data } = work;
const media = getWorkMedia(data.slug);
const categoryText = data.category === "game" ? "Game" : data.category === "software" ? "Software" : "Experiment";
---
<article class="card" data-category={data.category}>
  <a class="card-media" href={"/works/" + data.slug + "/"} aria-label={"View " + data.title + " details"}>
    <MediaBlock src={media.cover} alt={data.title + " cover"} hint={data.title.toUpperCase()} />
  </a>
  <div class="card-body">
    <span class="card-category">{categoryText}</span>
    <h2><a href={"/works/" + data.slug + "/"}>{data.title}</a></h2>
    <p>{data.summary}</p>
    <a class="card-link" href={"/works/" + data.slug + "/"}>View details →</a>
  </div>
</article>
