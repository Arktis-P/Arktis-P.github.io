---
import SiteLayout from "../layouts/SiteLayout.astro";
import { t } from "../lib/i18n";
---
<SiteLayout titleKey="page.404.title" descriptionKey="page.404.description">
  <section class="shell not-found">
    <span class="overline" data-i18n-key="page.404.eyebrow">{t("page.404.eyebrow")}</span>
    <h1 data-i18n-key="page.404.heading">{t("page.404.heading")}</h1>
    <p class="muted" data-i18n-key="page.404.body">{t("page.404.body")}</p>
    <a class="btn btn-primary" href="/works/"><span data-i18n-key="page.404.cta">{t("page.404.cta")}</span> →</a>
  </section>
</SiteLayout>
