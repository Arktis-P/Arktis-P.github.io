---
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import WorkCard from "../../components/WorkCard.astro";
import { t } from "../../lib/i18n";
const published = (await getCollection("works", ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order || a.data.slug.localeCompare(b.data.slug));
---
<SiteLayout titleKey="page.works.title" descriptionKey="page.works.description">
  <div class="shell">
    <header class="page-intro">
      <span class="overline" data-i18n-key="works.eyebrow">{t("works.eyebrow")}</span>
      <h1 data-i18n-key="works.heading">{t("works.heading")}</h1>
      <p data-i18n-key="works.intro">{t("works.intro")}</p>
    </header>
    <div class="controls" aria-label={t("a11y.workFiltering")} data-i18n-aria-label="a11y.workFiltering">
      <div class="filters" role="group" aria-label={t("a11y.categories")} data-i18n-aria-label="a11y.categories">
        <button class="filter" type="button" data-filter="all" aria-pressed="true" data-i18n-key="works.filter.all">{t("works.filter.all")}</button>
        <button class="filter" type="button" data-filter="game" aria-pressed="false" data-i18n-key="works.filter.game">{t("works.filter.game")}</button>
        <button class="filter" type="button" data-filter="software" aria-pressed="false" data-i18n-key="works.filter.software">{t("works.filter.software")}</button>
        <button class="filter" type="button" data-filter="experiment" aria-pressed="false" data-i18n-key="works.filter.experiment">{t("works.filter.experiment")}</button>
      </div>
      <span class="results-count" id="results-count" data-i18n-count={published.length} role="status" aria-live="polite">
        {t(published.length === 1 ? "works.count.one" : "works.count.other").replace("{count}", String(published.length))}
      </span>
    </div>
    <div class="work-grid" id="work-grid">
      {published.map((work) => <WorkCard work={work} />)}
    </div>
    <p class="empty-message" id="empty-results" hidden data-i18n-key="works.empty">{t("works.empty")}</p>
  </div>
  <script>
    const filters = Array.from(document.querySelectorAll("[data-filter]"));
    const cards = Array.from(document.querySelectorAll("[data-category]"));
    const count = document.getElementById("results-count");
    const empty = document.getElementById("empty-results");
    for (const button of filters) {
      button.addEventListener("click", () => {
        const selected = button.dataset.filter ?? "all";
        for (const control of filters) control.setAttribute("aria-pressed", String(control === button));
        let visible = 0;
        for (const card of cards) {
          const show = selected === "all" || card.dataset.category === selected;
          card.hidden = !show;
          if (show) visible++;
        }
        if (count) count.setAttribute("data-i18n-count", String(visible));
        if (empty) empty.hidden = visible !== 0;
        document.dispatchEvent(new Event("site:refresh-translations"));
      });
    }
  </script>
</SiteLayout>
