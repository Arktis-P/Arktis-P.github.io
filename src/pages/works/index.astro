---
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import WorkCard from "../../components/WorkCard.astro";

const published = (await getCollection("works", ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order || a.data.slug.localeCompare(b.data.slug));
---
<SiteLayout title="Works" description="Browse the published games and software projects from Burning Arktis.">
  <div class="shell">
    <header class="page-intro">
      <span class="overline">Selected portfolio</span>
      <h1>Our Works<span style="color:var(--accent)">.</span></h1>
      <p>Games, software and selected experiments. Discover the public projects and their verified download or source links.</p>
    </header>
    <div class="controls" aria-label="Work filtering">
      <div class="filters" role="group" aria-label="Categories">
        <button class="filter" type="button" data-filter="all" aria-pressed="true">All</button>
        <button class="filter" type="button" data-filter="game" aria-pressed="false">Games</button>
        <button class="filter" type="button" data-filter="software" aria-pressed="false">Software</button>
        <button class="filter" type="button" data-filter="experiment" aria-pressed="false">Experiments</button>
      </div>
      <span class="results-count" id="results-count" role="status" aria-live="polite">{published.length} works</span>
    </div>
    <div class="work-grid" id="work-grid">
      {published.map((work) => <WorkCard work={work} />)}
    </div>
    <p class="empty-message" id="empty-results" hidden>No published works in this category yet. Select another filter.</p>
  </div>
  <script>
    // Progressive enhancement: without JavaScript all approved works remain visible.
    const filters = Array.from(document.querySelectorAll("[data-filter]"));
    const cards = Array.from(document.querySelectorAll("[data-category]"));
    const count = document.getElementById("results-count");
    const empty = document.getElementById("empty-results");
    for (const button of filters) {
      button.addEventListener("click", () => {
        const selected = button.dataset.filter ?? "all";
        for (const control of filters) {
          control.setAttribute("aria-pressed", String(control === button));
        }
        let visible = 0;
        for (const card of cards) {
          const show = selected === "all" || card.dataset.category === selected;
          card.hidden = !show;
          if (show) visible++;
        }
        if (count) count.textContent = visible + (visible === 1 ? " work" : " works");
        if (empty) empty.hidden = visible !== 0;
      });
    }
  </script>
</SiteLayout>
