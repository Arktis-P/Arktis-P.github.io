---
import { getCollection, render, type CollectionEntry } from "astro:content";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import MediaBlock from "../../../components/MediaBlock.astro";
import { getWorkMedia } from "../../../lib/media";

interface Props { work: CollectionEntry<"works">; }
export async function getStaticPaths() {
  const works = await getCollection("works", ({ data }) => !data.draft);
  return works.map((work) => ({
    params: { slug: work.data.slug },
    props: { work },
  }));
}
const { work } = Astro.props;
const { Content } = await render(work);
const media = getWorkMedia(work.data.slug);
const platform = work.data.category === "game" ? "Game" : work.data.category === "software" ? "Software" : "Experiment";
const primary = work.data.links.primary;
const secondary = work.data.links.secondary;
---
<SiteLayout title={work.data.title} description={work.data.summary}>
  <div class="shell">
    <a class="detail-back" href="/works/">← Back to Works</a>
    <div class="detail-head">
      <div>
        <span class="overline">{platform} / Published work</span>
        <h1>{work.data.title}</h1>
        <p class="intro">{work.data.summary}</p>
      </div>
      <div class="detail-cta"><a class="btn btn-primary" href={primary.url} target="_blank" rel="noopener noreferrer">{primary.label} ↗</a></div>
    </div>
    <MediaBlock src={media.cover} alt={work.data.title + " cover"} hint={work.data.title.toUpperCase()} className="detail-visual" eager />
    <section class="detail-body" aria-label="Project details">
      <article>
        <span class="overline">Overview</span>
        <h2>About this work</h2>
        <div class="prose"><Content /></div>
      </article>
      <aside aria-label="Project information">
        <span class="overline">Project facts</span>
        <dl class="fact-list">
          <div><dt>Category</dt><dd>{platform}</dd></div>
          <div><dt>Attribution</dt><dd>{work.data.attribution}</dd></div>
          <div><dt>Platform</dt><dd>{work.data.platforms.join(", ")}</dd></div>
        </dl>
        {secondary.length > 0 && (
          <>
            <p class="overline" style="margin-top:29px">Related links</p>
            <div class="related-links">
              {secondary.map((link) => (
                <a class="btn btn-outline" href={link.url} target={link.url.startsWith("https:") ? "_blank" : undefined} rel={link.url.startsWith("https:") ? "noopener noreferrer" : undefined}>{link.label} ↗</a>
              ))}
            </div>
          </>
        )}
      </aside>
    </section>
    {media.screenshots.length > 0 && (
      <section class="detail-gallery" aria-label="Screenshots">
        <span class="overline">Gallery</span>
        <h2>Screenshots</h2>
        <div class="gallery-grid">
          {media.screenshots.map((src, index) => <img src={src} alt={work.data.title + " screenshot " + (index + 1)} loading="lazy" decoding="async" />)}
        </div>
      </section>
    )}
  </div>
</SiteLayout>
