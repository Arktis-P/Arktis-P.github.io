---
import { getCollection, getEntry, render } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";
import MediaBlock from "../components/MediaBlock.astro";
import { getBrandMedia, getWorkMedia } from "../lib/media";

const home = await getEntry("home", "home");
const contact = await getEntry("contact", "contact");
const about = await getEntry("about", "about");
if (!home || !contact || !about) throw new Error("Missing required home, contact or about content");
const { Content: AboutContent } = await render(about);
const published = await getCollection("works", ({ data }) => !data.draft);
const featured = home.data.featured_works
  .map((slug) => published.find((entry) => entry.data.slug === slug && entry.data.featured))
  .filter((entry) => entry !== undefined);
const media = getBrandMedia();
const headlineWords = home.data.headline.trim().split(/\s+/);
const headlineHighlight = headlineWords.pop() ?? "";
const headlineLead = headlineWords.join(" ");
---
<SiteLayout title="Home" description={home.data.introduction}>
  <div class="shell">
    <section class="hero" aria-labelledby="hero-title">
      <div>
        <span class="eyebrow">{home.data.eyebrow}</span>
        <h1 id="hero-title">{headlineLead} <em>{headlineHighlight}</em></h1>
        <p class="lead">{home.data.introduction}</p>
        <div class="actions"><a class="btn btn-primary" href="/works/">{home.data.primary_cta_label} →</a></div>
      </div>
      <MediaBlock src={media.hero} alt="Burning Arktis studio showcase artwork" hint="STUDIO VISUAL" className="hero-art" eager />
    </section>
  </div>
  {featured.length > 0 && (
    <div style="border-top:1px solid var(--line)">
      <section class="shell section" aria-labelledby="featured-title">
        <div class="section-top">
          <div><span class="overline">Selected work</span><h2 id="featured-title">Featured Project</h2></div>
          <a class="text-link" href="/works/">All works →</a>
        </div>
        {featured.map((work) => (
          <article class="featured">
            <MediaBlock src={getWorkMedia(work.data.slug).cover} alt={work.data.title + " cover art"} hint={work.data.title.toUpperCase()} />
            <div class="featured-content">
              <span class="card-category">{work.data.category}</span>
              <h3>{work.data.title}</h3>
              <p>{work.data.summary}</p>
              <a class="btn btn-primary" href={"/works/" + work.data.slug + "/"}>View project →</a>
            </div>
          </article>
        ))}
      </section>
    </div>
  )}
  <div style="border-top:1px solid var(--line)">
    <section class="shell section about-grid" aria-label="About and contact">
      <div class="about-card">
        <span class="overline">About us</span>
        <h3>Independent by design.</h3>
        <div class="prose"><AboutContent /></div>
      </div>
      <div class="about-card">
        <span class="overline">Contact & support</span>
        <h3>Get in touch.</h3>
        <p>Questions about our work or Anvil Bastion? Contact us directly.</p>
        <a class="text-link" href={"mailto:" + contact.data.email}>{contact.data.email} ↗</a>
      </div>
    </section>
  </div>
</SiteLayout>
