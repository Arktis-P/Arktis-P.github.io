---
import { getEntry } from "astro:content";
import { getBrandMedia } from "../lib/media";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import { t } from "../lib/i18n";
import "../styles/global.css";
interface Props {
  titleKey: string;
  descriptionKey: string;
  ogImage?: string;
  noindex?: boolean;
}
const { titleKey, descriptionKey, ogImage, noindex = false } = Astro.props;
const contact = await getEntry("contact", "contact");
if (!contact) throw new Error("Missing public contact record");
const brand = getBrandMedia();
const pathname = Astro.url.pathname;
const current = pathname === "/" ? "home" : pathname.startsWith("/works") ? "works" : null;
const siteBase = Astro.site ?? new URL("https://arktis-p.github.io");
const canonical = new URL(pathname, siteBase).toString();
const resolvedOgImage = ogImage ?? brand.hero;
const ogImageUrl = resolvedOgImage ? new URL(resolvedOgImage, siteBase).toString() : null;
const titleText = t(titleKey) + " | Burning Arktis";
const descriptionText = t(descriptionKey);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0c0d10" />
    <meta name="description" content={descriptionText} data-i18n-description={descriptionKey} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <title data-i18n-title={titleKey}>{titleText}</title>
    {brand.mark && <link rel="icon" type="image/png" href={brand.mark} />}
    {brand.mark && <link rel="apple-touch-icon" href={brand.mark} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;700&family=Space+Grotesk:wght@500;700&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={titleText} />
    <meta property="og:description" content={descriptionText} />
    {!noindex && <meta property="og:url" content={canonical} />}
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta name="twitter:card" content={ogImageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={titleText} />
    <meta name="twitter:description" content={descriptionText} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem("burning-arktis-locale");
          var preferred = (saved === "en" || saved === "ko")
            ? saved
            : ((navigator.language || "").toLowerCase().startsWith("ko") ? "ko" : "en");
          if (preferred === "ko") {
            document.documentElement.lang = "ko";
            document.documentElement.setAttribute("data-i18n-pending", "true");
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content" data-i18n-key="a11y.skip">{t("a11y.skip")}</a>
    <header class="header"><div class="shell header-inner">
      <a class="brand" href="/" aria-label={t("a11y.brandHome")} data-i18n-aria-label="a11y.brandHome">
        {brand.wordmark ? <img src={brand.wordmark} alt="Burning Arktis" width="180" height="45" /> : (
          <>{brand.mark ? <img src={brand.mark} alt="" width="34" height="38" /> : <span class="brand-symbol" aria-hidden="true"></span>}
          <span class="brand-letters"><span>BURNING</span><span>ARKTIS</span></span></>
        )}
      </a>
      <nav class="nav" aria-label={t("a11y.primary")} data-i18n-aria-label="a11y.primary">
        <a href="/" aria-current={current === "home" ? "page" : undefined} data-i18n-key="nav.home">{t("nav.home")}</a>
        <a href="/works/" aria-current={current === "works" ? "page" : undefined} data-i18n-key="nav.works">{t("nav.works")}</a>
      </nav>
      <LanguageSwitcher />
    </div></header>
    <main id="content"><slot /></main>
    <footer class="footer"><div class="shell footer-row">
      <span>© {new Date().getFullYear()} Burning Arktis</span>
      <div class="footer-links">
        <a href={contact.data.privacy_url} data-i18n-key="footer.privacy">{t("footer.privacy")}</a>
        <a href={"mailto:" + contact.data.email} data-i18n-key="footer.contact">{t("footer.contact")}</a>
        <a href={contact.data.github_url} target="_blank" rel="noopener noreferrer" data-i18n-key="footer.github">{t("footer.github")}</a>
      </div>
    </div></footer>
  </body>
</html>
